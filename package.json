{
  "name": "classifier-dev",
  "version": "1.0.0",
  "description": "Zero-shot text classification over plain HTTP, on Cloudflare Workers.",
  "main": "index.js",
  "scripts": {
    "test": "bun test",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 e2e/dimensions.live.mts",
    "test:e2e:accounts": "node --experimental-strip-types --test --test-concurrency=1 e2e/account.live.mts",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "eval": "cd eval && python3 run.py",
    "bench": "cd eval && python3 bench.py",
    "single": "cd eval && python3 single.py",
    "vs-jev": "cd eval && python3 vs_jev.py",
    "dev": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "db:migrate": "bun scripts/migrate-postgres.ts",
    "db:local": "bun --env-file=.dev.vars scripts/migrate-postgres.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "prebuild": "npm run build:admin",
    "predev": "npm run build:admin",
    "test:e2e:spending": "node e2e/spending.mjs"
  },
  "keywords": [],
  "author": "Michael Ryaboy",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "atmn": "2.0.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.122.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "@workos-inc/node": "^10.13.0",
    "@workos/authkit-tanstack-react-start": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.4.0",
    "nucleo-core-essential-outline-24": "^1.1.7",
    "nucleo-ui-essential-outline-18": "^1.1.8",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
